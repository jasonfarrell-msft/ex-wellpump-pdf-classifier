# Documentation only: ASP.NET Core does not automatically load this file.
# Production: ManagedIdentity is the system-assigned identity, never a secret fallback.
PORT=8080
ASPNETCORE_URLS=http://0.0.0.0:8080
ASPNETCORE_ENVIRONMENT=Production
Cloud__Credential=ManagedIdentity
Cloud__PublicOrigin=https://REPLACE-WITH-DEPLOYED-DEFAULT-HOSTNAME
Cloud__BlobEndpoint=https://stwellpumpdocsswmx01.blob.core.windows.net/
Cloud__QueueEndpoint=https://stwellpumpdocsswmx01.queue.core.windows.net/
Cloud__DocumentIntelligenceEndpoint=https://doc-wellpump-swc-mx01.cognitiveservices.azure.com/
Cloud__ClassifierId=wellpump-page-classifier-v1.1
DemoLimits__RetentionHours=24
DemoLimits__ParserTimeoutSeconds=60
# Disabled by default. Temporary DI401 identity diagnostics only:
# Diagnostics__ExpectedPrincipalId=<expected-system-assigned-principal-GUID>
# Diagnostics__ExpectedTenantId=<optional-expected-tenant-GUID>
# Remove both after troubleshooting. Never put tokens or credentials in these settings.
# Local development ONLY: explicitly use Cloud__Credential=AzureCli,
# ASPNETCORE_ENVIRONMENT=Development, PORT=3000, Cloud__PublicOrigin=http://localhost:5173.
# No keys, connection strings, client secrets, passwords or tokens belong here.
